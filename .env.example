# 对话模型来源：deepseek（在线）或 ollama（本地离线）
REPOLENS_PROVIDER=deepseek

# DeepSeek 在线模型 https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 本地 Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 本地向量模型（需先 ollama pull bge-m3）
REPOLENS_EMBED_MODEL=bge-m3
